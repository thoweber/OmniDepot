# OmniDepot AGY Local Environment Variables
# Copy this file to agy.env and populate your credentials

# GitHub Personal Access Token (for GitHub MCP server & upstream GitHub Package Proxying)
# Required scopes: repo, workflow, read:org
GITHUB_TOKEN=ghp_yourGitHubPersonalAccessTokenHere

# SonarCloud Security Token (for SonarCloud MCP server & ./mvnw sonar:sonar analysis)
SONAR_TOKEN=your_sonarcloud_personal_access_token_here
SONAR_HOST_URL=https://sonarcloud.io
SONAR_ORGANIZATION=thoweber
SONAR_PROJECT_KEY=OmniDepot

# IntelliJ IDEA MCP Server Proxy Port (default: 64343)
INTELLIJ_PORT=64343

# Quarkus Environment Profile (dev, test, prod)
QUARKUS_PROFILE=dev

# OmniDepot Local Auth Mode (enabled | disabled)
REPO_AUTH_MODE=disabled
