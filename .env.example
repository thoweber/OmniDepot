# OmniDepot Local Environment Variables
# Copy this file to .env and populate your credentials

# GitHub Personal Access Token (for GitHub MCP server & upstream GitHub Package Proxying)
# Required scopes: repo, workflow, read:org
GITHUB_TOKEN=ghp_yourGitHubPersonalAccessTokenHere

# IntelliJ IDEA MCP Server Proxy Port (default: 63342)
INTELLIJ_PORT=63342

# Quarkus Environment Profile (dev, test, prod)
QUARKUS_PROFILE=dev

# OmniDepot Local Auth Mode (enabled | disabled)
REPO_AUTH_MODE=disabled
