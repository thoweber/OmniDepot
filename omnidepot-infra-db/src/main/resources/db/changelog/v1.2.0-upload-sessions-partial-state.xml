<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1.2.0-upload-sessions-sha256-partial-state-pg" author="omnidepot" dbms="postgresql">
        <addColumn tableName="upload_sessions">
            <column name="sha256_partial_state" type="BYTEA"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="upload_sessions" columnName="sha256_partial_state"/>
        </rollback>
    </changeSet>

    <changeSet id="1.2.0-upload-sessions-sha256-partial-state-h2" author="omnidepot" dbms="h2">
        <addColumn tableName="upload_sessions">
            <column name="sha256_partial_state" type="BLOB"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="upload_sessions" columnName="sha256_partial_state"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
