{
  "mcpServers": {
    "intellij": {
      "type": "sse",
      "url": "http://127.0.0.1:64343/sse",
      "headers": {
        "IJ_MCP_SERVER_PROJECT_PATH": "/home/developer/projects/omnidepot"
      }
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "archunitChecker": {
      "command": "node",
      "args": [
        ".agents/scripts/archunit-checker-server.js"
      ]
    },
    "liquibaseValidator": {
      "command": "node",
      "args": [
        ".agents/scripts/liquibase-validator-server.js"
      ]
    }
  }
}
